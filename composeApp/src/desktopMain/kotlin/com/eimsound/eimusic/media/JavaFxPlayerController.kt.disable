package com.eimsound.eimusic.media

import com.eimsound.eimusic.cycle
import com.eimsound.eimusic.events.EventSource
import com.eimsound.eimusic.events.PlaybackEvent
import com.eimsound.eimusic.factory.TrackUriResolverFactory
import com.eimsound.eimusic.music.PlayMode
import com.eimsound.eimusic.music.PlayerState
import com.eimsound.eimusic.music.Track
import com.eimsound.eimusic.music.TrackId
import com.eimsound.eimusic.together.PlayState
import com.eimsound.eimusic.together.SyncState
import javafx.application.Platform
import javafx.beans.value.ChangeListener
import javafx.scene.media.Media
import javafx.scene.media.MediaPlayer
import kotlinx.coroutines.CoroutineScope
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.SupervisorJob
import kotlinx.coroutines.flow.MutableSharedFlow
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.SharedFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asSharedFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.flow.update
import kotlinx.coroutines.launch
import java.util.concurrent.ConcurrentHashMap

open class JavaFxPlayerController(open val trackUriResolverFactory: TrackUriResolverFactory) {
    // 缓存最近使用的 MediaPlayer 实例，最多缓存 20 个
    private companion object {
        private const val MAX_CACHE_SIZE = 20
        private val mediaPlayerCache = ConcurrentHashMap<TrackId, MediaPlayer>()
        private val accessOrder = mutableListOf<TrackId>()
    }

    private var mediaPlayer: MediaPlayer? = null

    private val _state = MutableStateFlow(PlayerState())
    open val state: StateFlow<PlayerState> = _state.asStateFlow()

    private val _event = MutableSharedFlow<PlaybackEvent>(replay = 0)
    open val event: SharedFlow<PlaybackEvent> = _event.asSharedFlow()

    private val scope = CoroutineScope(Dispatchers.Main + SupervisorJob())

    private var pendingReadyCallback: (() -> Unit)? = null
    private var isReady = MutableStateFlow(false)
    private var statusChangeListener: ChangeListener<MediaPlayer.Status>? = null
    private var timeChangeListener: ChangeListener<javafx.util.Duration>? = null

    /**
     * 准备播放指定的媒体源
     */
    private fun prepare(media: Track) {
        release()
        mediaPlayer = createMediaPlayer(media.uri ?: return)
    }


    /**
     * 清理当前播放器
     */
    private fun cleanupCurrentPlayer() {
        mediaPlayer?.let { player ->
            player.stop()
            statusChangeListener?.let { player.statusProperty().removeListener(it) }
            timeChangeListener?.let { player.currentTimeProperty().removeListener(it) }
            player.dispose()
        }
        mediaPlayer = null
    }


    private fun createMediaPlayer(source: String): MediaPlayer {
        val media = Media(source)
        return MediaPlayer(media).apply {
            setupStatusListener()
            setupTimeListener()
            setupReadyHandler()
            setupEndOfMediaHandler()
            setupBufferProgressListener()
            setupErrorHandler()
        }
    }

    private fun MediaPlayer.setupStatusListener() {
        statusChangeListener = ChangeListener { _, _, newStatus ->
            _state.update {
                it.copy(
                    playState = when (newStatus) {
                        MediaPlayer.Status.PLAYING -> PlayState.PLAYING
                        MediaPlayer.Status.PAUSED -> PlayState.PAUSED
                        else -> PlayState.STOPPED
                    },
                    isLoading = (newStatus == MediaPlayer.Status.STALLED)
                )
            }
        }
        statusProperty().addListener(statusChangeListener)
    }

    private fun MediaPlayer.setupTimeListener() {
        timeChangeListener = ChangeListener { _, _, newValue ->
            _state.update { it.copy(position = newValue.toMillis().toLong()) }
        }
        currentTimeProperty().addListener(timeChangeListener)
    }

    private fun MediaPlayer.setupReadyHandler() {
        setOnReady {
            volume = _state.value.volume.toDouble()
            isMute = _state.value.isMute
            _state.update { it.copy(duration = totalDuration.toMillis().toLong(), isLoading = false) }
            play()

            if (isReady.value) {
                isReady.value = false
                pendingReadyCallback?.invoke()
                pendingReadyCallback = null
            }
        }
    }

    private fun MediaPlayer.setupEndOfMediaHandler() {
        setOnEndOfMedia { next(true) }
    }

    private fun MediaPlayer.setupBufferProgressListener() {
        bufferProgressTimeProperty().addListener { _, _, newProgress ->
            val totalDuration = totalDuration?.toMillis()
            if (totalDuration != null && totalDuration > 0) {
                val progress = newProgress.toMillis() / totalDuration
                _state.update {
                    it.copy(bufferProgress = progress.coerceIn(0.0, 1.0).toFloat())
                }
            }
        }
    }

    private fun MediaPlayer.setupErrorHandler() {
        onErrorProperty().addListener { _, _, _ ->
            _state.update { it.copy(isLoading = false) }
        }
    }


    /**
     * 跳转到指定位置
     * @param millis 目标位置
     * @param seekOver 跳转完成回调
     */
    open fun seek(millis: Long, seekOver: () -> Unit) {
        Platform.runLater {
            mediaPlayer?.seek(javafx.util.Duration.millis(millis.toDouble()))
            seekOver()
        }
    }

    /**
     * 释放当前媒体播放器资源
     */
    open fun release() {
        cleanupCurrentPlayer()
    }

    open fun queue(medias: List<Track>, prepareOver: () -> Unit) {
        _state.update { it.copy(queue = medias) }
        prepareOver()
        playMode(state.value.playMode)
    }

    open fun playState(state: PlayState) {
        when (state) {
            PlayState.PLAYING -> mediaPlayer?.play()
            PlayState.PAUSED -> mediaPlayer?.pause()
            PlayState.STOPPED -> mediaPlayer?.stop()
        }
    }

    open fun playMode(mode: PlayMode) {
        _state.update { it.copy(playMode = mode) }
    }

    open fun volume(volume: Float, isMuted: Boolean) {
        mediaPlayer?.volume = volume.toDouble()
        mediaPlayer?.isMute = isMuted
        _state.update {
            it.copy(
                volume = volume,
                isMute = isMuted
            )
        }
    }


    open fun nextTrack(): Track? {
        val list = getCurrentPlayList()
        if (list.isEmpty()) return null

        val index = (_state.value.index + 1).cycle(0, list.size - 1)
        val current = list[index]

        return if (_state.value.playMode is PlayMode.RepeatOne) {
            state.value.current ?: current
        } else {
            current
        }
    }

    open fun next(isAudioCompleted: Boolean) {
        when (_state.value.playMode) {
            is PlayMode.Shuffle, is PlayMode.Loop -> {
                nextTrack()?.let { play(it, isAudioCompleted) }
            }

            is PlayMode.RepeatOne -> seek(0) {}
        }
    }

    open fun previousTrack(): Track? {
        val list = getCurrentPlayList()
        if (list.isEmpty()) return null

        val index = (_state.value.index - 1).cycle(0, list.size - 1)
        val current = list[index]

        return if (_state.value.playMode is PlayMode.RepeatOne) {
            state.value.current ?: current
        } else {
            current
        }
    }

    open fun previous() {
        when (_state.value.playMode) {
            is PlayMode.Shuffle, is PlayMode.Loop -> {
                previousTrack()?.let { play(it, false) }
            }

            is PlayMode.RepeatOne -> seek(0) {}
        }
    }

    private fun getCurrentPlayList(): List<Track> = _state.value.currentList

    open fun play(media: Track) {
        play(media, isAudioCompleted = false)
    }

    private fun play(media: Track, isAudioCompleted: Boolean = false) {
        val list = getCurrentPlayList()
        _state.update {
            it.copy(
                index = list.indexOfFirst { track -> track.id == media.id },
                current = media,
                isLoading = true
            )
        }

        scope.launch {
            if (isAudioCompleted) {
                _event.emit(
                    PlaybackEvent.TrackChanged(
                        media,
                        isAudioCompleted = true,
                        source = EventSource.Player
                    )
                )
            }
            val trackUriResolver = trackUriResolverFactory.get(media.source)
            val uri = trackUriResolver.resolve(media)
            val media = media.copy(uri = uri)
            prepare(media)
        }
    }

    open fun sync(syncState: SyncState) {
        val medias = syncState.trackList ?: return
        val current = state.value.current
        val index = syncState.track?.let { track ->
            medias.indexOfFirst { track.id == it.id }
        }

        _state.update {
            it.copy(
                queue = medias,
                index = index ?: it.index,
                current = syncState.track ?: it.current,
                playMode = syncState.playMode ?: it.playMode,
                playState = syncState.playState ?: it.playState,
                position = syncState.position ?: it.position,
            )
        }

        syncState.playMode?.let { playMode(it) }

        if (syncState.track?.id != current?.id) {
            handleTrackChange(syncState)
        } else {
            syncState.position?.let { position ->
                seek(position) {
                    syncState.playState?.let { state -> playState(state) }
                }
            }
        }
    }

    private fun handleTrackChange(syncState: SyncState) {
        isReady.value = true
        play(syncState.track ?: return, isAudioCompleted = false)
        pendingReadyCallback = {
            syncState.position?.let { position ->
                seek(position) {
                    syncState.playState?.let { state -> playState(state) }
                }
            }
        }
    }

    open fun addTrack(media: Track, index: Int) {
        val existingIndex = state.value.queue.indexOfFirst { track -> track.id == media.id }
        _state.update {
            val updatedQueue = it.queue.toMutableList().apply {
                if (existingIndex != -1) removeAt(existingIndex)
                add(index, media)
            }

            it.copy(
                queue = updatedQueue,
                index = recalculateIndex(updatedQueue)
            )
        }
    }

    open fun removeTrack(index: Int) {
        _state.update {
            val updatedQueue = it.queue.toMutableList().apply { removeAt(index) }
            it.copy(
                queue = updatedQueue,
                index = recalculateIndex(updatedQueue)
            )
        }
    }

    private fun recalculateIndex(newQueue: List<Track>) =
        newQueue.indexOfFirst { track -> track.id == state.value.current?.id }
}